<div class="admission-page">
  <section class="admission-hero">
    <div class="admission-container admission-hero__grid">
      <div class="admission-hero__content">
        <span class="admission-eyebrow">Admissions 2026</span>
        <h1>Build the future<br><em>you imagine.</em></h1>
        <p>Start your college journey in a community where strong academics, practical experience, and personal support come together.</p>
        <a class="admission-button" href="#apply">Start your application <span aria-hidden="true">&darr;</span></a>
      </div>
      <div class="admission-hero__panel">
        <p class="admission-hero__panel-label">Applications are open</p>
        <strong>Fall 2026 intake</strong>
        <ul>
          <li><span>01</span> Select your preferred program</li>
          <li><span>02</span> Complete the application form</li>
          <li><span>03</span> Speak with an admissions adviser</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="admission-benefits" aria-label="Admission benefits">
    <div class="admission-container admission-benefits__grid">
      <div><strong>50+</strong><span>Programs</span></div>
      <div><strong>95%</strong><span>Placement rate</span></div>
      <div><strong>200+</strong><span>Faculty members</span></div>
      <div><strong>1:18</strong><span>Faculty ratio</span></div>
    </div>
  </section>

  <section class="admission-apply" id="apply">
    <div class="admission-container admission-apply__grid">
      <aside class="admission-guide">
        <span class="admission-eyebrow">Apply today</span>
        <h2>Your next chapter starts here</h2>
        <p>Complete the form and our admissions team will guide you through eligibility, documents, fees, and the next steps.</p>
        <div class="admission-guide__note">
          <span aria-hidden="true">?</span>
          <div>
            <strong>Need help?</strong>
            <p>Email <a href="mailto:admissions@ourcollege.edu">admissions@ourcollege.edu</a> or call <a href="tel:+12345678900">+1 (234) 567-8900</a>.</p>
          </div>
        </div>
      </aside>
      <div class="admission-form-card">
        {{ form }}
      </div>
    </div>
  </section>
</div>

