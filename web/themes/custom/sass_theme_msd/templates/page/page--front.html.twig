{#
/**
 * @file
 * Front page template.
 */
#}
<div id="page-wrapper">
  <div id="page">

    {% include '@sass_theme_msd/header.html.twig' %}

    <main id="main" class="main-content" role="main">
      <a id="main-content" tabindex="-1"></a>

      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero__inner container">
          <div class="hero__content">
            <span class="hero__badge"><span></span> Est. 1965 &middot; Admissions Open</span>
            <h1 class="hero__title">Learn boldly.<br><em>Lead with purpose.</em></h1>
            <p class="hero__subtitle">A thriving learning community pairing excellent academics with a vibrant campus life &mdash; built to turn ambitious students into confident professionals.</p>
            <div class="hero__buttons">
              <a href="#courses" class="btn btn--primary btn--lg">Explore Courses <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
              <a href="#about" class="btn btn--outline btn--lg">Discover Our College</a>
            </div>
          </div>

          <div class="hero__visual">
            <div class="hero__image-wrap">
              <img src="/themes/custom/sass_theme_msd/images/campus.jpg" alt="Students gathering on the college campus">
              <div class="hero__image-shade"></div>
            </div>
            <div class="hero__float-card hero__float-card--top">
              <span class="hero__float-icon" aria-hidden="true">&#10003;</span>
              <span><strong>95%</strong> placement rate</span>
            </div>
            <div class="hero__float-card hero__float-card--bottom">
              <span class="hero__float-label">A global campus</span>
              <strong>50+ countries represented</strong>
            </div>
          </div>

          <div class="hero__stats" aria-label="College at a glance">
            <div class="hero__stat">
              <span class="hero__stat-num">5,000+</span>
              <span class="hero__stat-label">Students</span>
            </div>
            <div class="hero__stat">
              <span class="hero__stat-num">200+</span>
              <span class="hero__stat-label">Faculty</span>
            </div>
            <div class="hero__stat">
              <span class="hero__stat-num">50+</span>
              <span class="hero__stat-label">Programs</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FEATURES ============ -->
      <section id="features" class="features section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Why Our College</span>
            <h2 class="section-title">Built for your growth</h2>
            <p class="section-subtitle">Four pillars that make our graduates stand out in the competitive world.</p>
          </div>
          <div class="features__grid">
            <div class="features__card">
              <div class="features__icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </div>
              <h3 class="features__card-title">Expert Faculty</h3>
              <p class="features__card-desc">Learn from industry leaders and renowned academics with decades of experience.</p>
            </div>
            <div class="features__card">
              <div class="features__icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <h3 class="features__card-title">Modern Facilities</h3>
              <p class="features__card-desc">State-of-the-art labs, smart classrooms, and a vast digital library on campus.</p>
            </div>
            <div class="features__card">
              <div class="features__icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3 class="features__card-title">Global Community</h3>
              <p class="features__card-desc">Join a diverse student body drawn from more than 50 countries worldwide.</p>
            </div>
            <div class="features__card">
              <div class="features__icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <h3 class="features__card-title">Career Support</h3>
              <p class="features__card-desc">A dedicated placement cell with a 95%+ placement record across top companies.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ ABOUT ============ -->
      <section id="about" class="about section">
        <div class="container">
          <div class="about__grid">
            <div class="about__media">
              <img src="/themes/custom/sass_theme_msd/images/campus.jpg" alt="Students on campus" loading="lazy">
            </div>
            <div class="about__body">
              <span class="eyebrow">About Us</span>
              <h2 class="about__title">Where curiosity meets community</h2>
              <p class="about__text">College life is about far more than attending classes. It is an opportunity to discover new interests, build friendships, and prepare for your future. Our campus brings together supportive mentorship, modern learning spaces, and a culture of collaboration.</p>
              <p class="about__text">Every student here is encouraged to ask questions, think critically, and lead &mdash; supported by faculty who know them by name.</p>
              <ul class="about__points">
                <li class="about__point">Modern classrooms and practical laboratories</li>
                <li class="about__point">Dedicated faculty mentors throughout your journey</li>
                <li class="about__point">Clubs, sports, seminars and events year-round</li>
                <li class="about__point">Career readiness and communication training</li>
              </ul>
              <a href="/student-admission" class="btn btn--primary">Start Your Journey <span class="btn__arrow">&rarr;</span></a>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ STATS ============ -->
      <section id="stats" class="stats section">
        <div class="container">
          <div class="stats__grid">
            <div class="stats__item">
              <span class="stats__number">5000+</span>
              <span class="stats__label">Students Enrolled</span>
            </div>
            <div class="stats__item">
              <span class="stats__number">200+</span>
              <span class="stats__label">Faculty Members</span>
            </div>
            <div class="stats__item">
              <span class="stats__number">50+</span>
              <span class="stats__label">Courses Offered</span>
            </div>
            <div class="stats__item">
              <span class="stats__number">95%</span>
              <span class="stats__label">Placement Rate</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ COURSES ============ -->
      <section id="courses" class="courses section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Programs</span>
            <h2 class="section-title">Popular courses</h2>
            <p class="section-subtitle">Discover programs designed to shape the leaders of tomorrow.</p>
          </div>
          <div class="courses__grid">
            <article class="courses__card">
              <div class="courses__card-img">
                <img src="/themes/custom/sass_theme_msd/images/course-cs.svg" alt="Computer Science students coding" loading="lazy">
                <span class="courses__tag">B.Tech</span>
              </div>
              <div class="courses__card-body">
                <h3 class="courses__card-title">Computer Science &amp; Engineering</h3>
                <p class="courses__card-desc">Master programming, AI, machine learning, and software development through hands-on projects.</p>
                <div class="courses__card-meta">
                  <span>4 Years</span>
                  <span>60+ Labs</span>
                </div>
                <a href="#contact" class="courses__more">View program <span class="btn__arrow">&rarr;</span></a>
              </div>
            </article>
            <article class="courses__card">
              <div class="courses__card-img">
                <img src="/themes/custom/sass_theme_msd/images/course-business.svg" alt="Business students collaborating" loading="lazy">
                <span class="courses__tag">BBA</span>
              </div>
              <div class="courses__card-body">
                <h3 class="courses__card-title">Business Administration</h3>
                <p class="courses__card-desc">Develop leadership, strategy and management skills for the global business landscape.</p>
                <div class="courses__card-meta">
                  <span>3 Years</span>
                  <span>Internships</span>
                </div>
                <a href="#contact" class="courses__more">View program <span class="btn__arrow">&rarr;</span></a>
              </div>
            </article>
            <article class="courses__card">
              <div class="courses__card-img">
                <img src="/themes/custom/sass_theme_msd/images/course-medical.svg" alt="Medical sciences laboratory" loading="lazy">
                <span class="courses__tag">MBBS</span>
              </div>
              <div class="courses__card-body">
                <h3 class="courses__card-title">Medical Sciences</h3>
                <p class="courses__card-desc">Comprehensive medical education with clinical training at affiliated partner hospitals.</p>
                <div class="courses__card-meta">
                  <span>5 Years</span>
                  <span>Clinical Rotations</span>
                </div>
                <a href="#contact" class="courses__more">View program <span class="btn__arrow">&rarr;</span></a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ CTA / CONTACT ============ -->
      <section id="contact" class="cta section">
        <div class="container">
          <div class="cta__box">
            <h2 class="cta__title">Ready to begin your journey?</h2>
            <p class="cta__text">Applications for the upcoming term are now open. Speak with our admissions team and find the program that fits you.</p>
            <div class="cta__buttons">
              <a href="/student-admission" class="btn btn--primary btn--lg">Apply Now <span class="btn__arrow">&rarr;</span></a>
              <a href="#courses" class="btn btn--outline btn--lg">Browse Programs</a>
            </div>
          </div>
        </div>
      </section>

      {% if home_news_view %}
        <section class="home-news section" aria-labelledby="home-news-title">
          <div class="container">
            <div class="section-head">
              <span class="eyebrow">Campus stories</span>
              <h2 id="home-news-title" class="section-title">Latest news</h2>
              <p class="section-subtitle">Explore announcements, achievements, and stories from across our college community.</p>
            </div>
            <div class="home-news__view">
              {{ home_news_view }}
            </div>
          </div>
        </section>
      {% endif %}

    </main>

    {% include '@sass_theme_msd/footer.html.twig' %}

  </div>
</div>
